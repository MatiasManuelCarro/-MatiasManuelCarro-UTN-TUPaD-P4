@baseUrl = http://127.0.0.1:8000/api/v1


###############################################################################
# SETUP - CREAR PRODUCTO BASE
###############################################################################

### POST valido - Crear producto con stock
# Esperado: 201 Created
# @name crearProducto
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Ravioles de verdura",
    "precio_base": 4500.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 10.500,
    "disponible": true
}


###############################################################################
# GET - LISTADO
###############################################################################

### GET - Listar productos activos
# Esperado: 200 OK
GET {{baseUrl}}/productos/


###############################################################################
# GET - PRODUCTO POR ID
###############################################################################

### GET - Obtener producto existente
# Esperado: 200 OK
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}


###############################################################################
# FILTROS DEL LISTADO
###############################################################################

### GET - Buscar productos por nombre
# Esperado: Ravioles
GET {{baseUrl}}/productos/?search=Ravio


### GET - Productos disponibles
GET {{baseUrl}}/productos/?disponible=true


### GET - Productos activos
GET {{baseUrl}}/productos/?activo=true


### GET - Paginacion
GET {{baseUrl}}/productos/?skip=0&limit=10


###############################################################################
# RN-01 - VALIDACIONES DE PRODUCTO
###############################################################################

### POST - Nombre menor a 3 caracteres
# Esperado: 422 Unprocessable Entity
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "AB",
    "descripcion": "Prueba de validacion",
    "precio_base": 1000.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 5.000,
    "disponible": true
}


### POST - Precio negativo
# Esperado: 422 Unprocessable Entity
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto precio negativo",
    "descripcion": "Prueba de validacion",
    "precio_base": -100.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 5.000,
    "disponible": true
}


### POST - Stock negativo
# Esperado: 422 Unprocessable Entity
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto stock negativo",
    "descripcion": "Prueba de validacion",
    "precio_base": 1000.00,
    "unidad_venta_id": 1,
    "stock_cantidad": -1.000,
    "disponible": true
}


### PUT - Stock negativo
# Esperado: 422 Unprocessable Entity
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Prueba RN-01 en actualizacion",
    "precio_base": 4800.00,
    "unidad_venta_id": 1,
    "stock_cantidad": -1.000,
    "disponible": true
}


###############################################################################
# RN-02 - NOMBRE UNICO ENTRE PRODUCTOS ACTIVOS
###############################################################################

### POST - Nombre repetido
# Esperado: 409 Conflict
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Otro producto con el mismo nombre",
    "precio_base": 5000.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 5.000,
    "disponible": true
}


###############################################################################
# RN-03 - RECURSOS INEXISTENTES
###############################################################################

### GET - Producto inexistente
# Esperado: 404 Not Found
GET {{baseUrl}}/productos/999999


### PUT - Producto inexistente
# Esperado: 404 Not Found
PUT {{baseUrl}}/productos/999999
Content-Type: application/json

{
    "nombre": "Producto inexistente",
    "descripcion": "Prueba RN-03",
    "precio_base": 1000.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 5.000,
    "disponible": true
}


### DELETE - Producto inexistente
# Esperado: 404 Not Found
DELETE {{baseUrl}}/productos/999999


### POST - Unidad de venta inexistente
# Esperado: 404 Not Found
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto con unidad inexistente",
    "descripcion": "Prueba RN-03",
    "precio_base": 1000.00,
    "unidad_venta_id": 999999,
    "stock_cantidad": 5.000,
    "disponible": true
}


### PUT - Unidad de venta inexistente
# Esperado: 404 Not Found
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Prueba RN-03 al actualizar",
    "precio_base": 4800.00,
    "unidad_venta_id": 999999,
    "stock_cantidad": 10.000,
    "disponible": true
}


###############################################################################
# RN-10 - STOCK EN UNIDADES CONTABLES
###############################################################################

### POST - Pieza con stock decimal
# unidad_venta_id 5 = pieza, tipo contable
# Esperado: 422 Unprocessable Entity
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Empanada",
    "descripcion": "Empanada individual",
    "precio_base": 1500.00,
    "unidad_venta_id": 5,
    "stock_cantidad": 10.500,
    "disponible": true
}


### POST - Pieza con stock entero
# Esperado: 201 Created
# @name crearProductoContable
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Empanada",
    "descripcion": "Empanada individual",
    "precio_base": 1500.00,
    "unidad_venta_id": 5,
    "stock_cantidad": 10,
    "disponible": true
}


### PUT - Cambiar producto a pieza con stock decimal
# Esperado: 422 Unprocessable Entity
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Prueba RN-10 en actualizacion",
    "precio_base": 4800.00,
    "unidad_venta_id": 5,
    "stock_cantidad": 10.500,
    "disponible": true
}


###############################################################################
# RN-02 - NOMBRE REPETIDO AL ACTUALIZAR
###############################################################################

### PUT - Intentar actualizar Empanada con nombre Ravioles
# Esperado: 409 Conflict
PUT {{baseUrl}}/productos/{{crearProductoContable.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Intento de nombre repetido",
    "precio_base": 1500.00,
    "unidad_venta_id": 5,
    "stock_cantidad": 10,
    "disponible": true
}


###############################################################################
# RN-11 - HAY_STOCK
###############################################################################

### GET - Verificar hay_stock con stock mayor a 0
# Esperado: hay_stock = true
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}


### PUT - Actualizar producto y llevar stock a 0
# Esperado: 200 OK y hay_stock = false
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Ravioles de verdura actualizados",
    "precio_base": 4800.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 0,
    "disponible": true
}


### GET - Verificar hay_stock despues de llevar stock a 0
# Esperado: stock_cantidad = 0 y hay_stock = false
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}


###############################################################################
# RN-12 - DISPONIBLE, ACTIVO Y STOCK SON INDEPENDIENTES
###############################################################################

### PUT - Pausar venta manteniendo stock en 0
# Esperado: 200 OK y disponible = false
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "Ravioles de verdura actualizados",
    "precio_base": 4800.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 0,
    "disponible": false
}


### GET - Productos con venta pausada
# Esperado: Ravioles debe aparecer
GET {{baseUrl}}/productos/?disponible=false


###############################################################################
# DELETE - BAJA LOGICA
###############################################################################

### DELETE - Anular producto
# Esperado: 204 No Content
DELETE {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}


###############################################################################
# VERIFICACIONES DESPUES DE LA BAJA
###############################################################################

### GET - El producto anulado no aparece en el listado por defecto
GET {{baseUrl}}/productos/


### GET - Listar productos anulados
# Esperado: Ravioles debe aparecer
GET {{baseUrl}}/productos/?activo=false


### GET - Producto anulado por ID
# Esperado: 200 OK
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}


###############################################################################
# RN-04 - ANULAR DOS VECES
###############################################################################

### DELETE - Intentar anular nuevamente
# Esperado: 409 Conflict
DELETE {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}


###############################################################################
# RN-05 - MODIFICAR PRODUCTO ANULADO
###############################################################################

### PUT - Intentar modificar producto anulado
# Esperado: 409 Conflict
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ravioles",
    "descripcion": "No deberia modificarse",
    "precio_base": 5000.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 10.000,
    "disponible": true
}


###############################################################################
# FILTRO CATEGORIA_ID
###############################################################################

### GET - Filtrar productos por categoria
# La preparación de la relación se demuestra en relaciones.http.
# Reemplazar 1 por el ID de la categoria utilizada en relaciones.http.
GET {{baseUrl}}/productos/?categoria_id=1