@baseUrl = http://127.0.0.1:8000/api/v1


###############################################################################
# SETUP - CREAR PRODUCTO
###############################################################################

### Crear producto para las pruebas de relaciones
# Esperado: 201 Created
# @name crearProductoRelacion
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Sorrentinos",
    "descripcion": "Sorrentinos de jamon y queso",
    "precio_base": 5200.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 15.000,
    "disponible": true
}


###############################################################################
# CATEGORIAS - ALTA
###############################################################################

### Crear primera categoria
# Esperado: 201 Created
# @name crearCategoriaPastas
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
    "nombre": "Pastas",
    "descripcion": "Productos de pastas"
}


### Crear segunda categoria
# Esperado: 201 Created
# @name crearCategoriaPromociones
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
    "nombre": "Promociones",
    "descripcion": "Productos en promocion"
}


###############################################################################
# CATEGORIAS - LISTADO
###############################################################################

### GET - Listar categorias activas
# Esperado: 200 OK
# Deben aparecer Pastas y Promociones
GET {{baseUrl}}/categorias/


###############################################################################
# CATEGORIAS - GET POR ID
###############################################################################

### GET - Obtener categoria existente
# Esperado: 200 OK
GET {{baseUrl}}/categorias/{{crearCategoriaPastas.response.body.$.id}}


###############################################################################
# CATEGORIAS - FILTRO SEARCH
###############################################################################

### GET - Buscar categoria por nombre
# Esperado: debe aparecer Pastas
GET {{baseUrl}}/categorias/?search=Past


###############################################################################
# RN-01 - NOMBRE DE CATEGORIA MENOR A 3 CARACTERES
###############################################################################

### POST - Nombre demasiado corto
# Esperado: 422 Unprocessable Entity
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
    "nombre": "AB",
    "descripcion": "Categoria invalida"
}


###############################################################################
# RN-02 - NOMBRE DE CATEGORIA REPETIDO
###############################################################################

### POST - Crear categoria con nombre repetido
# Esperado: 409 Conflict
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
    "nombre": "Pastas",
    "descripcion": "Otra categoria con el mismo nombre"
}


###############################################################################
# CATEGORIAS - ACTUALIZACION
###############################################################################

### PUT - Actualizar categoria Promociones
# Esperado: 200 OK
PUT {{baseUrl}}/categorias/{{crearCategoriaPromociones.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Ofertas",
    "descripcion": "Productos en oferta"
}


###############################################################################
# RN-02 - NOMBRE REPETIDO AL ACTUALIZAR CATEGORIA
###############################################################################

### PUT - Intentar renombrar Ofertas como Pastas
# Esperado: 409 Conflict
PUT {{baseUrl}}/categorias/{{crearCategoriaPromociones.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Pastas",
    "descripcion": "Intento de nombre repetido"
}


###############################################################################
# RN-03 - CATEGORIA INEXISTENTE
###############################################################################

### GET - Categoria inexistente
# Esperado: 404 Not Found
GET {{baseUrl}}/categorias/999999


### PUT - Categoria inexistente
# Esperado: 404 Not Found
PUT {{baseUrl}}/categorias/999999
Content-Type: application/json

{
    "nombre": "Categoria inexistente",
    "descripcion": "Prueba RN-03"
}


### DELETE - Categoria inexistente
# Esperado: 404 Not Found
DELETE {{baseUrl}}/categorias/999999


###############################################################################
# RN-07 / RN-09 - PRIMERA CLASIFICACION
###############################################################################

### Clasificar producto en Pastas como principal
# Esperado: 201 Created
POST {{baseUrl}}/productos/{{crearProductoRelacion.response.body.$.id}}/categorias
Content-Type: application/json

{
    "categoria_id": {{crearCategoriaPastas.response.body.$.id}},
    "es_principal": true
}


###############################################################################
# GET - CATEGORIAS DEL PRODUCTO
###############################################################################

### Ver categorias del producto
# Esperado:
# Pastas -> es_principal = true
GET {{baseUrl}}/productos/{{crearProductoRelacion.response.body.$.id}}/categorias


###############################################################################
# RN-09 - CAMBIO DE CATEGORIA PRINCIPAL
###############################################################################

### Clasificar en Ofertas como nueva principal
# Esperado: 201 Created
POST {{baseUrl}}/productos/{{crearProductoRelacion.response.body.$.id}}/categorias
Content-Type: application/json

{
    "categoria_id": {{crearCategoriaPromociones.response.body.$.id}},
    "es_principal": true
}


### Verificar que solamente quede una categoria principal
# Esperado:
# Pastas  -> es_principal = false
# Ofertas -> es_principal = true
GET {{baseUrl}}/productos/{{crearProductoRelacion.response.body.$.id}}/categorias


###############################################################################
# RN-07 - CLASIFICACION DUPLICADA
###############################################################################

### Intentar clasificar nuevamente en Pastas
# Esperado: 409 Conflict
POST {{baseUrl}}/productos/{{crearProductoRelacion.response.body.$.id}}/categorias
Content-Type: application/json

{
    "categoria_id": {{crearCategoriaPastas.response.body.$.id}},
    "es_principal": false
}


###############################################################################
# FILTRO categoria_id
###############################################################################

### Listar productos pertenecientes a Pastas
# Esperado: debe aparecer Sorrentinos una sola vez
GET {{baseUrl}}/productos/?categoria_id={{crearCategoriaPastas.response.body.$.id}}


###############################################################################
# RN-06 - ANULAR CATEGORIA
###############################################################################

### DELETE - Anular categoria Pastas
# Esperado: 204 No Content
DELETE {{baseUrl}}/categorias/{{crearCategoriaPastas.response.body.$.id}}


###############################################################################
# CATEGORIAS - FILTRO ACTIVO FALSE
###############################################################################

### GET - Listar categorias anuladas
# Esperado: debe aparecer Pastas
GET {{baseUrl}}/categorias/?activo=false


###############################################################################
# RN-06 - ANULAR CATEGORIA NO ANULA PRODUCTO
###############################################################################

### Consultar producto despues de anular Pastas
# Esperado: 200 OK
# El producto Sorrentinos sigue existiendo
GET {{baseUrl}}/productos/{{crearProductoRelacion.response.body.$.id}}


###############################################################################
# RN-04 - ANULAR CATEGORIA DOS VECES
###############################################################################

### DELETE - Intentar anular nuevamente Pastas
# Esperado: 409 Conflict
DELETE {{baseUrl}}/categorias/{{crearCategoriaPastas.response.body.$.id}}


###############################################################################
# RN-05 - MODIFICAR CATEGORIA ANULADA
###############################################################################

### PUT - Intentar modificar Pastas despues de anularla
# Esperado: 409 Conflict
PUT {{baseUrl}}/categorias/{{crearCategoriaPastas.response.body.$.id}}
Content-Type: application/json

{
    "nombre": "Pastas modificadas",
    "descripcion": "No deberia modificarse"
}


###############################################################################
# RN-08 - NO CLASIFICAR EN CATEGORIA ANULADA
###############################################################################

### Crear producto secundario
# Esperado: 201 Created
# @name crearProductoSecundario
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Tallarines",
    "descripcion": "Tallarines frescos",
    "precio_base": 4000.00,
    "unidad_venta_id": 1,
    "stock_cantidad": 8.000,
    "disponible": true
}


### Intentar clasificar producto activo en categoria Pastas anulada
# Esperado: 409 Conflict
POST {{baseUrl}}/productos/{{crearProductoSecundario.response.body.$.id}}/categorias
Content-Type: application/json

{
    "categoria_id": {{crearCategoriaPastas.response.body.$.id}},
    "es_principal": false
}


###############################################################################
# RN-08 - NO CLASIFICAR PRODUCTO ANULADO
###############################################################################

### DELETE - Anular producto secundario
# Esperado: 204 No Content
DELETE {{baseUrl}}/productos/{{crearProductoSecundario.response.body.$.id}}


### Intentar clasificar producto anulado en categoria activa
# Esperado: 409 Conflict
POST {{baseUrl}}/productos/{{crearProductoSecundario.response.body.$.id}}/categorias
Content-Type: application/json

{
    "categoria_id": {{crearCategoriaPromociones.response.body.$.id}},
    "es_principal": false
}


###############################################################################
# RN-03 - CATEGORIA INEXISTENTE AL CLASIFICAR
###############################################################################

### Intentar clasificar usando categoria inexistente
# Esperado: 404 Not Found
POST {{baseUrl}}/productos/{{crearProductoRelacion.response.body.$.id}}/categorias
Content-Type: application/json

{
    "categoria_id": 999999,
    "es_principal": false
}