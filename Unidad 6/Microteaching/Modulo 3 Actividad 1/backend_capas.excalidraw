      "text": "weapon/router.py\n\nrouter = APIRouter(prefix=\"/weapons\", tags=[\"Weapons\"])\n\n\n@router.post(\"/\")\ndef create_weapon(\n    weapon: WeaponCreate,\n    session: Session = Depends(get_session)\n):\n    return service.create_weapon(session, weapon)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "weapon/router.py\n\nrouter = APIRouter(prefix=\"/weapons\", tags=[\"Weapons\"])\n\n\n@router.post(\"/\")\ndef create_weapon(\n    weapon: WeaponCreate,\n    session: Session = Depends(get_session)\n):\n    return service.create_weapon(session, weapon)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
