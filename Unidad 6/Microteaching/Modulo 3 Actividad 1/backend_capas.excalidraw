      "text": "weapon/models.py\n\nclass Weapon(SQLModel, table=True):\n    id: int | None = Field(default=None, primary_key=True)\n    name: str\n\n    hero: Optional[\"Hero\"] = Relationship(back_populates=\"weapon\")",
