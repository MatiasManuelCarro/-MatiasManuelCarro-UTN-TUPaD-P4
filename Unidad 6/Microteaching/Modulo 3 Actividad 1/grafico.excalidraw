      "link": null,
      "locked": false,
      "text": "def get_hero(session: Session, hero_id: int):\n    statement = (\n        select(Hero)\n        .where(Hero.id == hero_id)\n        .options(selectinload(Hero.weapon))\n    )\n    return session.exec(statement).first()",
