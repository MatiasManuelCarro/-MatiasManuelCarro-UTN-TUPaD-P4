      "link": null,
      "locked": false,
      "text": "core/config.py\n\nclass Settings(BaseSettings):\n    DATABASE_URL: str\n\n    class Config:\n        env_file = os.path.join(\n            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),\n            \".env\"\n        )\n        env_file_encoding = \"utf-8\"\n\n\nsettings = Settings()\n\n# .env\nPOSTGRES_DB=appdb\nPOSTGRES_USER=postgres\nPOSTGRES_PASSWORD=postgres\nDATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "core/config.py\n\nclass Settings(BaseSettings):\n    DATABASE_URL: str\n\n    class Config:\n        env_file = os.path.join(\n            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),\n            \".env\"\n        )\n        env_file_encoding = \"utf-8\"\n\n\nsettings = Settings()\n\n# .env\nPOSTGRES_DB=appdb\nPOSTGRES_USER=postgres\nPOSTGRES_PASSWORD=postgres\nDATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
