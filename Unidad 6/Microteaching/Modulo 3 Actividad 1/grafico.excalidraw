      "link": null,
      "locked": false,
      "text": "hero/routers.py\n\nrouter = APIRouter(prefix=\"/heroes\", tags=[\"Heroes\"])\n\n\n@router.post(\"/\")\ndef create_hero(\n    hero: HeroCreate,\n    session: Session = Depends(get_session)\n):\n    return service.create_hero(session, hero)\n\n\n@router.get(\"/{hero_id}\")\ndef read_hero(\n    hero_id: int,\n    session: Session = Depends(get_session)\n):\n    return service.get_hero(session, hero_id)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hero/routers.py\n\nrouter = APIRouter(prefix=\"/heroes\", tags=[\"Heroes\"])\n\n\n@router.post(\"/\")\ndef create_hero(\n    hero: HeroCreate,\n    session: Session = Depends(get_session)\n):\n    return service.create_hero(session, hero)\n\n\n@router.get(\"/{hero_id}\")\ndef read_hero(\n    hero_id: int,\n    session: Session = Depends(get_session)\n):\n    return service.get_hero(session, hero_id)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
