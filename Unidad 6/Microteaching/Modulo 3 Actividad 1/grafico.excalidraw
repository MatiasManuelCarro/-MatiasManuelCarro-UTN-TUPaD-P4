      "boundElements": null,
      "updated": 1790861249848,
      "created": 1790861062045,
      "link": null,
      "locked": false,
      "text": "hero/models.py\n\nclass Hero(SQLModel, table=True):\n    id: int | None = Field(default=None, primary_key=True)\n    name: str\n\n    weapon_id: int | None = Field(\n        default=None,\n        foreign_key=\"weapon.id\",\n        unique=True\n    )\n\n    weapon: Optional[Weapon] = Relationship(back_populates=\"hero\")",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hero/models.py\n\nclass Hero(SQLModel, table=True):\n    id: int | None = Field(default=None, primary_key=True)\n    name: str\n\n    weapon_id: int | None = Field(\n        default=None,\n        foreign_key=\"weapon.id\",\n        unique=True\n    )\n\n    weapon: Optional[Weapon] = Relationship(back_populates=\"hero\")",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
