      "isDeleted": true,
      "boundElements": null,
      "updated": 1791854523854,
      "created": 1791854520916,
      "link": null,
      "locked": false,
      "text": "Si no pusieras ese [], React se volvería loco pidiendo los datos al\nbackend infinitas veces por segundo.",
      "fontSize": 20,
