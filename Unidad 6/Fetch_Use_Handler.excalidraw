    {
      "id": "wwgy7seUfk6Bv4g66eDRn",
      "type": "text",
      "x": -2398.9005577740377,
      "y": 1277.7028962463414,
      "width": 800,
      "height": 875,
      "angle": 0,
      "strokeColor": "#2f9e44",
