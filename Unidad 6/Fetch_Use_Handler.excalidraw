      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ajqATHHx0lKmNeaf4IpLZ",
      "type": "text",
      "x": 1689.8896857737889,
      "y": -1328.0930931471828,
      "width": 781,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zjSgUVxwWl9zNGd76wlJf"
      ],
      "frameId": null,
      "index": "bXg",
      "roundness": null,
      "seed": 1109474748,
      "version": 91,
      "versionNonce": 1387022908,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791855247263,
      "created": 1791855207190,
      "link": null,
      "locked": false,
      "text": "Return es la parte final y más importante del Hook. Es como el \"menú de\nopciones\" que este archivo le entrega a tus componentes visuales\n(botones, tablas, etc.).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Return es la parte final y más importante del Hook. Es como el \"menú de opciones\" que este archivo le entrega a tus componentes visuales (botones, tablas, etc.).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
