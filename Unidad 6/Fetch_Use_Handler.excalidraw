      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nLínea 1: async function handleCreate(data: CategoriaData) {",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WcQoGh152SODvAMWkTaoB",
