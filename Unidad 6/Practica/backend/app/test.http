###############################################
#                 CATEGORÍAS
###############################################

### Crear categoría 1
POST http://localhost:8000/categorias
Content-Type: application/json

{
  "nombre": "Tecnología",
  "descripcion": "Productos electrónicos"
}

### Crear categoría 2
POST http://localhost:8000/categorias
Content-Type: application/json

{
  "nombre": "Hogar",
  "descripcion": "Artículos para el hogar"
}

### Crear categoría 3
POST http://localhost:8000/categorias
Content-Type: application/json

{
  "nombre": "Gaming",
  "descripcion": "Accesorios gamer"
}

### Listar categorías
GET http://localhost:8000/categorias

### Listar categorías con limit=2
GET http://localhost:8000/categorias?skip=0&limit=2

### Obtener categoría por ID
GET http://localhost:8000/categorias/1

### Actualizar categoría
PATCH http://localhost:8000/categorias/1
Content-Type: application/json

{
  "descripcion": "Productos electrónicos y computación"
}

### Intentar eliminar categoría con productos asociados (debe fallar)
DELETE http://localhost:8000/categorias/1

### Eliminar categoría sin productos asociados
DELETE http://localhost:8000/categorias/2


###############################################
#                 PRODUCTOS
###############################################

### Crear producto con lista de imágenes y categorías
POST http://localhost:8000/productos
Content-Type: application/json

{
  "nombre": "Notebook Asus",
  "descripcion": "i7 32GB RAM",
  "precio": 550000,
  "imagen_url": ["img_asus1.png", "img_asus2.png", "img_asus3.png"],
  "disponible": true,
  "categoria_ids": [1, 3]
}

### Crear otro producto
POST http://localhost:8000/productos
Content-Type: application/json

{
  "nombre": "Mouse Logitech",
  "descripcion": "Inalámbrico",
  "precio": 15000,
  "imagen_url": ["mouse1.png"],
  "disponible": true,
  "categoria_ids": [3]
}

### Intentar crear producto duplicado (debe fallar)
POST http://localhost:8000/productos
Content-Type: application/json

{
  "nombre": "Mouse Logitech",
  "descripcion": "Duplicado",
  "precio": 10000,
  "imagen_url": ["dup.png"],
  "disponible": true,
  "categoria_ids": []
}

### Listar productos
GET http://localhost:8000/productos

### Listar productos activos
GET http://localhost:8000/productos?activo=true

### Listar productos con paginación
GET http://localhost:8000/productos?skip=0&limit=5

### Obtener producto por ID
GET http://localhost:8000/productos/1

### Actualizar producto (precio + imágenes)
PATCH http://localhost:8000/productos/1
Content-Type: application/json

{
  "precio": 499999,
  "imagen_url": ["asus_new1.png", "asus_new2.png"]
}

### Actualizar categorías del producto
PATCH http://localhost:8000/productos/1
Content-Type: application/json

{
  "categoria_ids": [3]
}

### Ver producto con categorías actualizadas
GET http://localhost:8000/productos/1

### Desactivar producto
PATCH http://localhost:8000/productos/2/desactivar

### Eliminar producto
DELETE http://localhost:8000/productos/2

### Intentar eliminar producto inexistente
DELETE http://localhost:8000/productos/999


###############################################
#        PRUEBAS DE RELACIONES (N–N)
###############################################

### Crear producto sin categorías
POST http://localhost:8000/productos
Content-Type: application/json

{
  "nombre": "Teclado Redragon",
  "descripcion": "Mecánico RGB",
  "precio": 30000,
  "imagen_url": ["teclado1.png"],
  "disponible": true,
  "categoria_ids": []
}

### Asignar categorías al producto
PATCH http://localhost:8000/productos/3
Content-Type: application/json

{
  "categoria_ids": [1, 3]
}

### Ver producto con categorías
GET http://localhost:8000/productos/3

### Intentar asignar categoría inexistente (debe fallar)
PATCH http://localhost:8000/productos/3
Content-Type: application/json

{
  "categoria_ids": [999]
}
