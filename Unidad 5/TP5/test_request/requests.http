### Variables (REST Client / VS Code)
@baseUrl = http://localhost:8000

############################################################
# CATEGORÍAS
############################################################

### Crear categoría
POST {{baseUrl}}/categorias/
Content-Type: application/json

< ./categoria_create.json

### Listar categorías
GET {{baseUrl}}/categorias/

### Obtener categoría por ID
GET {{baseUrl}}/categorias/1

### Actualizar categoría (PATCH)
PATCH {{baseUrl}}/categorias/1
Content-Type: application/json

< ./categoria_update.json

### Desactivar categoría
PATCH {{baseUrl}}/categorias/1/desactivar


############################################################
# PRODUCTOS
############################################################

### Crear producto
POST {{baseUrl}}/productos/
Content-Type: application/json

< ./producto_create.json

### Listar productos
GET {{baseUrl}}/productos/

### Obtener producto por ID
GET {{baseUrl}}/productos/1

### Actualizar producto (PATCH)
PATCH {{baseUrl}}/productos/1
Content-Type: application/json

< ./producto_update.json

### Desactivar producto
PATCH {{baseUrl}}/productos/1/desactivar

### Consultar stock
GET {{baseUrl}}/productos/1/stock


############################################################
# PROVEEDORES
############################################################

### Crear proveedor
POST {{baseUrl}}/proveedores/
Content-Type: application/json

< ./proveedor_create.json

### Listar proveedores
GET {{baseUrl}}/proveedores/

### Obtener proveedor por ID
GET {{baseUrl}}/proveedores/1

### Actualizar proveedor (PATCH)
PATCH {{baseUrl}}/proveedores/1
Content-Type: application/json

< ./proveedor_update.json

### Desactivar proveedor
PATCH {{baseUrl}}/proveedores/1/desactivar
